def show_menu():
    print("\n--- TO-DO LIST APP ---")
    print("1. Add Task")
    print("2. View Tasks")
    print("3. Delete Task")
    print("4. Exit")

def main():
    tasks = []
    
    while True:
        show_menu()
        choice = input("Apna option chunein (1-4): ")
        
        if choice == "1":
            task = input("Naya task likhein: ")
            tasks.append(task)
            print("Task add ho gaya!")
            
        elif choice == "2":
            if not tasks:
                print("Abhi koi task nahi hai.")
            else:
                print("\nAap ke Tasks:")
                for index, task in enumerate(tasks, start=1):
                    print(f"{index}. {task}")
                    
        elif choice == "3":
            # Yahan delete karne ka logic likhein
            pass
            
        elif choice == "4":
            print("Allah Hafiz!")
            break
        else:
            print("Ghalat option! Dobara koshish karein.")

if __name__ == "__main__":
    main()
